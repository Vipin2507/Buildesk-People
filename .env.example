# Server
PORT=8787
HOST=127.0.0.1

# Multi-tenant platform
# Auto-enables when at least one ready workspace exists. Set explicitly for clarity.
BUILDESK_MULTI_TENANT=false

# Keep legacy single-tenant login against data/buildesk.sqlite until you adopt and verify.
# Set to false only after adopting legacy data into a workspace and confirming email login.
BUILDESK_LEGACY_SINGLE_TENANT=true

# Bootstrap the first platform owner once (development / first deploy only).
# Never commit real credentials. Existing operators are never overwritten on startup.
BUILDESK_PLATFORM_OWNER_EMAIL=
BUILDESK_PLATFORM_OWNER_PASSWORD=
BUILDESK_PLATFORM_OWNER_NAME=Platform Owner

# Optional Microsoft Graph / automation secrets (existing app configuration)
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
